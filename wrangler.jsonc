{
  "name": "site-bharat-scaffolding-next",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    { "binding": "NEXT_INC_CACHE_KV", "id": "95e5b6a22f844a18a3f9613a34ae8aa0" }
  ],
  // ISR revalidation queue (open-next.config.ts `queue: doQueue`). Without it
  // stale pages are never regenerated — tyashin-platform CLAUDE.md §12c-bis.
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "site-bharat-scaffolding-next" }],
  "durable_objects": {
    "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  "vars": {
    "TYASHIN_API_URL": "https://website-api.tyashin.com",
    "NEXT_PUBLIC_SITE_DOMAIN": "preetbharat.com",
    "ROBOTS_NOINDEX": "true"
  }
}
